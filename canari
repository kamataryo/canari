def docx(blocks, beacon):
    def run(text, props=""):
        rpr = f"<w:rPr>{props}</w:rPr>" if props else ""
        return f'<w:r>{rpr}<w:t xml:space="preserve">{escape(text)}</w:t></w:r>'

    def tbl(rows):
        # 列幅は中身の長さから。はみ出す分は一番広い列で折り返させる
        need = [max(width(str(r[c])) for r in rows) * 110 + 240 for c in range(len(rows[0]))]
        widest = need.index(max(need))
        need[widest] -= max(0, sum(need) - TEXT_WIDTH)
        border = "".join(f'<w:{s} w:val="single" w:sz="4" w:space="0" w:color="auto"/>'
                         for s in ("top", "left", "bottom", "right", "insideH", "insideV"))
        grid = "".join(f'<w:gridCol w:w="{w}"/>' for w in need)
        trs = ""
        for i, row in enumerate(rows):
            props = BOLD if i == 0 else ""
            trs += "<w:tr>" + "".join(f'<w:tc><w:tcPr><w:tcW w:w="{w}" w:type="dxa"/></w:tcPr><w:p>{run(str(v), props)}</w:p></w:tc>'
                                      for v, w in zip(row, need)) + "</w:tr>"
        return (f'<w:tbl><w:tblPr><w:tblW w:w="{sum(need)}" w:type="dxa"/><w:tblBorders>{border}</w:tblBorders></w:tblPr>'
                f"<w:tblGrid>{grid}</w:tblGrid>{trs}</w:tbl>")

    pixel = ('<w:r><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="9525" cy="9525"/>'
             '<wp:docPr id="1" name="図 1"/><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture">'
             '<pic:pic><pic:nvPicPr><pic:cNvPr id="0" name="図 1"/><pic:cNvPicPr/></pic:nvPicPr>'
             f"<pic:blipFill>{BLIP}</pic:blipFill><pic:spPr>{SPPR}</pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r>")
    targets = [("image", beacon + ".gif", True), ("styles", "styles.xml", False)]
    body = ""
    for b in blocks:
        if isinstance(b, str):
            body += f"<w:p>{run(b)}</w:p>"
        elif isinstance(b, list):
            body += tbl(b)
        elif b[0] == "title":
            body += f'<w:p><w:pPr><w:spacing w:after="240"/></w:pPr>{run(b[1], TITLE)}{pixel}</w:p>'
        elif b[0] == "h":
            body += f'<w:p><w:pPr><w:spacing w:before="240"/></w:pPr>{run(b[1], BOLD)}</w:p>'
        elif b[0] == "link":
            targets.append(("hyperlink", beacon + b[1], True))
            body += f'<w:p><w:hyperlink r:id="rId{len(targets)}">{run(beacon + b[1], LINK)}</w:hyperlink></w:p>'
    ns = (f'xmlns:w="{NS_W}" xmlns:r="{NS_R}" xmlns:a="{NS_A}" '
          'xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" '
          'xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"')
    sect = ('<w:sectPr><w:pgSz w:w="11906" w:h="16838"/>'
            '<w:pgMar w:top="1985" w:right="1701" w:bottom="1701" w:left="1701" w:header="851" w:footer="992" w:gutter="0"/></w:sectPr>')
    styles = (f'<w:styles xmlns:w="{NS_W}"><w:docDefaults><w:rPrDefault><w:rPr>'
              '<w:rFonts w:ascii="游明朝" w:eastAsia="游明朝" w:hAnsi="游明朝"/><w:sz w:val="21"/>'
              '<w:lang w:val="en-US" w:eastAsia="ja-JP"/></w:rPr></w:rPrDefault></w:docDefaults></w:styles>')
    return {
        "[Content_Types].xml": content_types([
            ("word/document.xml", "officedocument.wordprocessingml.document.main+xml"),
            ("word/styles.xml", "officedocument.wordprocessingml.styles+xml"),
        ]),
        "_rels/.rels": root_rels("word/document.xml"),
        "word/document.xml": f"<w:document {ns}><w:body>{body}{sect}</w:body></w:document>",
        "word/styles.xml": styles,
        "word/_rels/document.xml.rels": rels(*targets),
    }


def fake_times():
    """それらしい作成日時と更新日時（更新は 1〜2 か月前の業務時間）"""
    modified = (datetime.now(JST) - timedelta(days=rng.randint(7, 60))).replace(
        hour=rng.randint(9, 18), minute=rng.randint(0, 59), second=rng.randint(0, 59), microsecond=0)
    return modified - timedelta(days=rng.randint(30, 300), minutes=rng.randint(0, 600)), modified


def txt(blocks, beacon):
    lines = []
    for b in blocks:
        if isinstance(b, str):
            lines.append(b)
        elif isinstance(b, list):
            lines += table([[str(v) for v in row] for row in b])
        elif b[0] == "title":
            lines.append(b[1])
        elif b[0] == "h":
            lines += ["", b[1]]
        elif b[0] == "link":
            lines.append(beacon + b[1])
    return "\n".join(lines) + "\n"


def render(spec, beacon, created, modified):
    kind = spec[0]
    if kind == "txt":
        return txt(spec[1], beacon).encode()
    parts = xlsx(spec[1], spec[2], beacon) if kind == "xlsx" else docx(spec[1], beacon)

    def utc(d):
        return d.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    parts["docProps/core.xml"] = (
        '<cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties" '
        'xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" '
        'xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">'
        f"<dc:creator>{rng.choice(SURNAMES)}</dc:creator><cp:lastModifiedBy>{rng.choice(SURNAMES)}</cp:lastModifiedBy>"
        f'<dcterms:created xsi:type="dcterms:W3CDTF">{utc(created)}</dcterms:created>'
        f'<dcterms:modified xsi:type="dcterms:W3CDTF">{utc(modified)}</dcterms:modified></cp:coreProperties>')
    app = "Microsoft Excel" if kind == "xlsx" else "Microsoft Office Word"
    parts["docProps/app.xml"] = (
        '<Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties">'
        f"<Application>{app}</Application></Properties>")
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w") as z:
        for name, xml in parts.items():
            info = zipfile.ZipInfo(name, modified.timetuple()[:6])
            info.compress_type = zipfile.ZIP_DEFLATED
            z.writestr(info, HEAD + xml)
    return buf.getvalue()


# --- サブコマンド ---

def cmd_new():
    base = beacon_base()
    tpls = templates(date.today())
    print("埋め込むファイル（番号をスペース区切り）")
    chosen = [tpls[i] for i in pick([name for _, name, _ in tpls])]
    exists = [name for _, name, _ in chosen if Path(name).exists()]
    if exists:
        sys.exit(f"既にあります: {' '.join(exists)}")
    memo = ""
    while not memo:
        memo = input("メモ: ").strip()
    for key, name, spec in chosen:
        token = secrets.token_urlsafe(16)
        created, modified = fake_times()
        data = render(spec(), f"{base}t/{token}", created, modified)
        # 台帳への登録が先。逆だと、登録に失敗したとき鳴らないファイルが残る
        aws("dynamodb", "put-item", "--table-name", TABLE, "--condition-expression", "attribute_not_exists(id)",
            "--item", json.dumps({
                "id": {"S": token}, "template": {"S": key}, "filename": {"S": name}, "description": {"S": memo},
                "created_at": {"N": str(int(time.time()))}, "hit_count": {"N": "0"},
            }))
        Path(name).write_bytes(data)
        os.utime(name, (modified.timestamp(), modified.timestamp()))
        print(f"✓ {name}")


def cmd_list():
    rows = [["状態", "作成日", "ファイル", "メモ", "検知", "最終検知"]]
    for it in items():
        rows.append([
            "失効" if "revoked_at" in it else "有効",
            jst(it["created_at"], "%Y-%m-%d"),
            it["filename"],
            it["description"],
            str(it.get("hit_count", 0)),
            jst(it["last_hit_at"], "%Y-%m-%d %H:%M") if "last_hit_at" in it else "-",
        ])
    print("\n".join(table(rows)))


def cmd_revoke():
    active = [it for it in items() if "revoked_at" not in it]
    if not active:
        sys.exit("有効なものはありません")
    print("失効させるもの（番号をスペース区切り）")
    chosen = pick(table([[jst(it["created_at"], "%Y-%m-%d"), it["filename"], it["description"]] for it in active]))
    for i in chosen:
        aws("dynamodb", "update-item", "--table-name", TABLE, "--key", json.dumps({"id": {"S": active[i]["id"]}}),
            "--update-expression", "SET revoked_at = :t",
            "--expression-attribute-values", json.dumps({":t": {"N": str(int(time.time()))}}))
    print(f"✓ {len(chosen)} 件")


def cmd_notify_add():
    topic = topic_arn()
    email = ""
    while "@" not in email:
        email = input("メール: ").strip()
    aws("sns", "subscribe", "--topic-arn", topic, "--protocol", "email", "--notification-endpoint", email)
    # リンクを開かずにここで確認すると、メール末尾の購読解除リンクでは解除できなくなる（AWS の認証が要る）
    url = input("確認メールのリンク URL（開かずにコピーして貼る）: ").strip()
    if not url:
        return print("確認メールのリンクを開いて確認してください")
    token = parse_qs(urlparse(url).query).get("Token")
    if not token:
        sys.exit("URL に Token がありません")
    aws("sns", "confirm-subscription", "--topic-arn", topic, "--token", token[0], "--authenticate-on-unsubscribe", "true")
    print(f"✓ {email}")


def cmd_notify_remove():
    subs = [s for s in subscriptions() if s["SubscriptionArn"].startswith("arn:")]  # 未確認のものは解除できない（3 日で消える）
    if not subs:
        sys.exit("外せるものはありません")
    print("外すもの（番号をスペース区切り）")
    chosen = pick([s["Endpoint"] for s in subs])
    for i in chosen:
        aws("sns", "unsubscribe", "--subscription-arn", subs[i]["SubscriptionArn"])
    print(f"✓ {len(chosen)} 件")


def cmd_stack():
    url = beacon_base()
    subs = subscriptions()
    count = aws("dynamodb", "scan", "--table-name", TABLE, "--select", "COUNT")["Count"]
    rows = [["URL", url], ["トークン", str(count)]]
    for s in subs:
        rows.append(["通知先", s["Endpoint"] + ("（未確認）" if s["SubscriptionArn"] == "PendingConfirmation" else "")])
    if not subs:
        rows.append(["通知先", "なし（canari notify add）"])
    print("\n".join(table(rows)))


COMMANDS = {
    "new": cmd_new,
    "list": cmd_list,
    "revoke": cmd_revoke,
    "notify add": cmd_notify_add,
    "notify remove": cmd_notify_remove,
    "stack": cmd_stack,
    "completion": lambda: print(ZSH),
}


def main():
    cmd = COMMANDS.get(" ".join(sys.argv[1:]))
    if not cmd:
        sys.exit(USAGE)
    try:
        cmd()
    except (KeyboardInterrupt, EOFError):
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
