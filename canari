def attr(s):
    return escape(s, {'"': "&quot;"})


def rels(*targets):
    out = []
    for i, (typ, target, external) in enumerate(targets, 1):
        mode = ' TargetMode="External"' if external else ""
        typ = typ if typ.startswith("http") else REL + typ
        out.append(f'<Relationship Id="rId{i}" Type="{typ}" Target="{attr(target)}"{mode}/>')
    return f'<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">{"".join(out)}</Relationships>'


def content_types(overrides):
    parts = [("docProps/core.xml", "package.core-properties+xml"), ("docProps/app.xml", "officedocument.extended-properties+xml"), *overrides]
    o = "".join(f'<Override PartName="/{p}" ContentType="{CT}{t}"/>' for p, t in parts)
    return ('<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
            f'<Default Extension="rels" ContentType="{CT}package.relationships+xml"/>'
            f'<Default Extension="xml" ContentType="application/xml"/>{o}</Types>')


def root_rels(main):
    return rels(("officeDocument", main, False),
                ("http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties", "docProps/core.xml", False),
                ("extended-properties", "docProps/app.xml", False))


