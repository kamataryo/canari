HEAD = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
# 1px の透明画像を外部参照（r:link）で置く。開いたアプリが取りに来る
BLIP = '<a:blip r:link="rId1"/><a:stretch><a:fillRect/></a:stretch>'
SPPR = '<a:xfrm><a:off x="0" y="0"/><a:ext cx="9525" cy="9525"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom>'
