# --- AWS ---

def aws(*args):
    r = subprocess.run(["aws", *args, "--output", "json"], capture_output=True, text=True)
    if r.returncode:
        sys.exit(NO_STACK if "ResourceNotFoundException" in r.stderr else r.stderr.strip())
    return json.loads(r.stdout.strip() or "null")


def topic_arn():
    return aws("lambda", "get-function-configuration", "--function-name", FUNCTION)["Environment"]["Variables"]["TOPIC"]


def items():
    rows = [{k: int(v["N"]) if "N" in v else v["S"] for k, v in it.items()}
            for it in aws("dynamodb", "scan", "--table-name", TABLE)["Items"]]
    return sorted(rows, key=lambda r: r["created_at"])  # ponytail: 全件 Scan。数千件までは困らない


def beacon_base():
    return aws("lambda", "get-function-url-config", "--function-name", FUNCTION)["FunctionUrl"]


def subscriptions():
    return aws("sns", "list-subscriptions-by-topic", "--topic-arn", topic_arn())["Subscriptions"]


# --- 端末の表示 ---

def width(s):
    return sum(2 if unicodedata.east_asian_width(c) in ("F", "W") else 1 for c in s)


def table(rows):
    widths = [max(width(r[i]) for r in rows) for i in range(len(rows[0]))]
    return ["  ".join(c + " " * (w - width(c)) for c, w in zip(r, widths)).rstrip() for r in rows]


def pick(labels):
    digits = len(str(len(labels)))
    for i, label in enumerate(labels, 1):
        print(f"  {i:>{digits}}) {label}")
    while True:
        try:
            nums = {int(s) for s in input("> ").split()}
        except ValueError:
            continue
        if nums and nums <= set(range(1, len(labels) + 1)):
            return sorted(n - 1 for n in nums)


def jst(ts, fmt):
    return datetime.fromtimestamp(ts, JST).strftime(fmt)


